{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "globals": {
    "timeManager": "writable",
    "passageRenderer": "writable",
    "PassageApp": "writable",
    "TimeManager": "writable",
    "PassageRenderer": "writable"
  },
  "rules": {
    "no-unused-vars": ["error", { "args": "none" }],
    "no-console": "off",
    "prefer-const": "error",
    "no-var": "error",
    "no-redeclare": "off"
  },
  "overrides": [
    {
      "files": ["scripts/**/*.js", "playwright.config.js", "test/**/*.js"],
      "env": {
        "browser": false,
        "node": true
      }
    }
  ]
}
